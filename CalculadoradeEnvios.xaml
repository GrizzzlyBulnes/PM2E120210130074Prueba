<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E120210130074Prueba.CalculadoradeEnvios"
             Title="CalculadoradeEnvios">
    <ScrollView>
        <!-- VerticalStackLayout: apila los controles uno debajo de otro -->
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            <Label Text="Calculadora de Envios" FontSize="24" FontAttributes="Bold" TextColor="#0ED9F0"
     HorizontalOptions="Center"/>

            <!-- Campo para agregar el peso -->
            <Label Text="Descripcion del paquete:" TextColor="Black" FontAttributes="Bold"/>

            <!-- Border: dibuja un marco con esquinas redondeadas al rededor del Entry -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0">

                <!-- x:Name es el nombre con el que C# encuentra este control (txtPeso.text)-->
                <!-- Keyboard="Numeric" muestra en pantalla numeros -->
                <Entry x:Name="txtDescripcion" Placeholder="Documentos o Paquete Ejemplo" Keyboard="Text"/>

            </Border>


            <Label Text="Peso del paquete (kg):" TextColor="Black" FontAttributes="Bold"/>

            <!-- Border: dibuja un marco con esquinas redondeadas al rededor del Entry -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0">
                <!-- x:Name es el nombre con el que C# encuentra este control (txtPeso.text)-->
                <!-- Keyboard="Numeric" muestra en pantalla numeros -->
                <Entry x:Name="txtPeso" Placeholder="2.5" Keyboard="Numeric"/>
            </Border>


            <Label Text="Zona de Destino:"/>
            <!-- Lista desplegable. Title es el texto que se mira antes de elegir cualquier opcion-->
            <Picker x:Name="pckDestino" Title="Zona Nacional">
                <Picker.Items>
                    <x:String>Zona Local</x:String>
                    <x:String>Zona Nacional</x:String>
                    <x:String>Zona Internacional</x:String>
                </Picker.Items>
            </Picker>


            <HorizontalStackLayout Spacing="5">
                <CheckBox x:Name="chkServicioExpres"/>
                <Label Text="Servicio Expres (+ L. 100.00)" VerticalOptions="Center" />
            </HorizontalStackLayout>


            <!-- Boton: Clicked="...." indica que metodo de C# se ejecuta al tocarlo -->
            <Button Text="CALCULAR ENVIO" Background="Black" TextColor="White" FontAttributes="Bold"
            CornerRadius="8" HeightRequest="48" Clicked="Button_Clicked"/>

            <!-- Tarjeta de resultado: IsVisible= False la oculta hasta que se calcule  -->
            <Border x:Name="brResultado"
        Stroke="Black"
        StrokeShape="RoundRectangle 12"
        Padding="20"
        IsVisible="False"
        Margin="0,10,0,0">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Resultado del envío"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

                    <Label x:Name="lblValorPaquete"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

                    <Label x:Name="lbl"
               FontSize="16"
               HorizontalOptions="Start"/>

                    <Label x:Name="lblResultado"
               FontSize="16"
               TextColor="#0C8A99"/>

                </VerticalStackLayout>
            </Border>



        </VerticalStackLayout>
    </ScrollView>
</ContentPage>